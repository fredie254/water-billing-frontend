  .badge-yellow { background: #fef9c3; color: #854d0e; }
  .badge-gray   { background: #f3f4f6; color: #374151; }
  .level-tag {
    display: inline-block;
    background: #e0f2fe;
    color: #0369a1;
    padding: 1pt 5pt;
    border-radius: 3pt;
    font-size: 8.5pt;
    font-weight: bold;
